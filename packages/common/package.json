{
  "name": "@weberon/common",
  "version": "0.0.1",
  "description": "TypeScript base PDF generator and React base UI. Open source, developed by the community, and completely free to use under the MIT license!",
  "keywords": [
    "pdf",
    "pdf-designer",
    "pdf-generation",
    "pdf-viewer",
    "react",
    "typescript"
  ],
  "homepage": "https://pdfme.com",
  "bugs": {
    "url": "https://github.com/weberon/pdfme/issues"
  },
  "license": "MIT",
  "author": "hand-dot",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weberon/pdfme.git"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "dev": "node set-version.js && vite build --watch",
    "build": "node set-version.js && vite build && tsc -p tsconfig.build.json",
    "clean": "rimraf dist",
    "lint": "vp lint -c ../../.oxlintrc.json src",
    "fmt": "vp fmt -c ../../.oxfmtrc.json src --write",
    "test": "vitest run --config ../../vitest.config.ts"
  },
  "dependencies": {
    "@weberon/pdf-lib": "*",
    "acorn": "^8.16.0",
    "buffer": "^6.0.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/estree": "^1.0.6"
  }
}



